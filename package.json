{
  "name": "shelfie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude \"tests/sandbox/**\" --exclude \"tests/ai-live/**\"",
    "test:watch": "vitest",
    "test:sandbox": "vitest run tests/sandbox",
    "test:ai": "vitest run tests/ai-live",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "screenshots:prod": "bash scripts/screenshots-prod.sh",
    "seed": "tsx scripts/seed-demo.ts",
    "clips": "tsx scripts/clips/record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Snap a photo of your price list; Shelfie turns it into a PayPal-backed shop any AI assistant can order from.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
