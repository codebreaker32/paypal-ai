# Copy to .env and fill in. Never commit .env.
# Shelfie talks to the PayPal SANDBOX only: never put live credentials here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PayPal REST app, SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
# The app's client secret
PAYPAL_SECRET_KEY=

# Anthropic API key for Claude (menu reading, order briefs, the in-app assistant).
# Unset: sample menus use their recorded reading and briefs use a plain template.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional app settings
# ---------------------------------------------------------------------------

# Pexels API key (free, pexels.com/api): a live search for an item's example photo when the bundled library has
# no close one; results are cached. Unset: only the bundled library is used.
PEXELS_API_KEY=
# Public base URL (PayPal return URLs and the agent door). Default: RENDER_EXTERNAL_URL on Render,
# else http://localhost:<the port the server runs on>
# APP_URL=http://localhost:3000
# Webhook id from the PayPal app's Webhooks section (only once deployed with a public HTTPS URL)
PAYPAL_WEBHOOK_ID=
# Contact address shown on the Help page. Unset: Help points at GitHub Issues
SUPPORT_EMAIL=
# Storage (defaults shown)
DATABASE_PATH=data/shelfie.db
UPLOADS_DIR=data/uploads

# ---------------------------------------------------------------------------
# Demo and seed (`npm run seed`)
# ---------------------------------------------------------------------------

# Sandbox BUSINESS (seller) account email. Every shop is paid into its seller's own PayPal account (the email they
# type during setup). The seeded shops are paid to this account when set; left empty, only the demo shop is seeded
# and it is paid to this app's own sandbox account, so the demo still runs with only the keys above
PAYPAL_SANDBOX_SELLER_EMAIL=
# 1 = sample menus use their recorded real reading even with a key (instant, for recording a demo).
# Your own photos are always read live
SHELFIE_RECORDED_SAMPLES=

# ---------------------------------------------------------------------------
# Testing, e2e and recording (leave empty for normal use)
# ---------------------------------------------------------------------------

# Sandbox PERSONAL (buyer) account: the e2e capture tests and clip recorder log in with it to pay seller-paid
# orders; leave empty to skip those tests
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Test harnesses only: 1 = a shop can be started without an account. Ignored on Render
SHELFIE_ALLOW_GUEST_SHOPS=
# Set to 1 by the test runners: skips setup rate limits, the background poller and the home chat's auto-open
# SHELFIE_TEST=
# Vitest: load a different env file instead of .env
# SHELFIE_ENV_FILE=
# Live AI tests: 1 = rewrite the recorded sample readings from the live result
# RECORD_FIXTURES=
# Playwright: port for the app it starts (default 3100); 1 = attach to an app already running on that port
# E2E_PORT=3100
# E2E_REUSE_SERVER=
# Playwright: folder for the judged-screen screenshots (npm run screenshots:prod sets it)
# SCREENSHOTS_DIR=
# Playwright: 1 = copy the capture test's screenshots into their folder
# SHELFIE_SCREENSHOTS=
# Playwright: folder for screen recordings (e2e/recordings.spec.ts)
# SHELFIE_RECORDINGS=
# Playwright: folders for the landing page and home chat screenshots; 1 = retake the "How it works" order image
# LANDING_SHOTS=
# HOME_CHAT_SHOTS=
# HIW_SHOT=
# Playwright: folder for the PWA check's output (default data/pwa)
# PWA_OUT=
# screenshots:prod: 1 = reuse the existing production build
# SKIP_BUILD=
# Scripts that drive a running app (measure-photo-to-live, illustration-sheet)
# BASE_URL=http://localhost:3000
# Clip recorder (npm run clips): output folder (default video/clips); the demo shop's owner link when attaching
# to a running app; 1 = stop right after the login to check it
# CLIPS_OUT=
# CLIPS_OWNER_LINK=
# CLIPS_CHECK_LOGIN=

# ---------------------------------------------------------------------------
# Set by the platform, not needed here
# ---------------------------------------------------------------------------
# RENDER, RENDER_EXTERNAL_URL: set by Render (RENDER turns guest shops off; the URL is the default APP_URL)
# NODE_ENV: set by Next.js (production: secure cookies, and webhooks are refused until PAYPAL_WEBHOOK_ID is set)
# PORT: set by the server (the default APP_URL uses it)
# NEXT_RUNTIME: set by Next.js (nodejs or edge)
