# Copy to .env and fill in. Never commit .env.

# PayPal REST app, SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
# The app's client secret
PAYPAL_SECRET_KEY=

# Anthropic API key for Claude (menu reading, order briefs, the in-app assistant)
ANTHROPIC_API_KEY=

# Optional
# Public base URL (PayPal return URLs and the agent door). Default: http://localhost:<the port the server runs on>
# APP_URL=http://localhost:3000
# Webhook id from the PayPal app's Webhooks section (only once deployed with a public HTTPS URL)
PAYPAL_WEBHOOK_ID=
# Sandbox BUSINESS (seller) account email. Every shop is paid into its seller's own PayPal account (the email they
# type during setup). The demo shop from `npm run seed` is paid to this account when set; left empty, it is paid
# to this app's own sandbox account instead, so the demo still runs with only the keys above
PAYPAL_SANDBOX_SELLER_EMAIL=
# Sandbox PERSONAL (buyer) account. Not used today (the end-to-end tests pay by guest card); leave empty
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# 1 = sample menus use their recorded real reading even with a key (instant, for recording a demo). Your own photos are always read live
SHELFIE_RECORDED_SAMPLES=
# Storage (defaults shown)
DATABASE_PATH=data/shelfie.db
UPLOADS_DIR=data/uploads
